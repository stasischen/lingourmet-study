    {
      "key": "lp-79379c21c9173117",
      "language": "ja",
      "lemma": "です",
      "pos": "auxiliary",
      "status": "candidate",
      "pronunciation": {
        "text": "です",
        "speech": "です",
        "lang": "ja-JP"
      },
      "definitions": {
        "zh-Hant": "用在名詞、い形容詞或な形容詞的述語中，使陳述更禮貌。中文譯法依整句意思而定，不一定逐字譯出「です」。",
        "en": "A polite form used with noun, i-adjective, and na-adjective predicates. Its English wording depends on the whole sentence.",
        "ja": "名詞・イ形容詞・ナ形容詞を述語にする文で、聞き手に丁寧に伝えるために使います。接続のしかたは、名詞や形容詞の種類によって異なります。"
      }
    },
    {
      "key": "lp-2b91d15da05b284a",
      "language": "ja",
      "lemma": "は",
      "pos": "particle",
      "status": "candidate",
      "pronunciation": {
        "text": "は",
        "speech": "わ",
        "lang": "ja-JP"
      },
      "definitions": {
        "zh-Hant": "標示談話主題的助詞。承接前文時，也可以省略後面已知的內容，轉問對方。",
        "en": "A particle that marks the topic. After a preceding statement, it can also introduce a question with the understood ending left out.",
        "ja": "話題を示す助詞。前の話を受けて、後ろの内容を省略して相手にたずねることもある。"
      }
    },
    {
      "key": "lp-3ec490f4b30f46ad",
      "language": "ja",
      "lemma": "はじめまして",
