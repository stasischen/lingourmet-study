  "entries": {
    "draft:ja:first-meeting-opening": {
      "localizations": {
        "zh-Hant": {
          "title": "初次見面的開場",
          "explanation": "第一次與對方見面、開始介紹自己時，可以說「はじめまして」，表示「初次見面」。接著說「ナオです」，就介紹了自己的姓名。"
        },
        "en": {
          "title": "Opening a first meeting",
          "explanation": "Use はじめまして when you meet someone for the first time: “Nice to meet you.” Follow it with ナオです to say “I’m Nao.”"
        },
        "ja": {
          "title": "初めて会う時のあいさつ",
          "explanation": "初めて会う人に自己紹介を始める時、「はじめまして」と言います。続けて「ナオです」と言うと、自分の名前を伝えられます。"
        }
      },
      "relatedRefs": [
        "draft:ja:cooperative-closing",
        "draft:ja:polite-noun-predicate",
        "draft:ja:topic-return-question"
      ],
      "exampleRefs": [
        "X01"
      ],
      "presentation": {
        "focusUnitRefs": [
          "X01.s1"
        ]
      }
    },
    "draft:ja:cooperative-closing": {
      "localizations": {
        "zh-Hant": {
          "title": "表達希望好好相處的結語",
          "explanation": "初次見面、介紹完自己後，可以說「よろしくお願いします」，表示「請多關照」。對方常用「こちらこそ、よろしくお願いします」回應。"
        },
        "en": {
          "title": "Closing with a wish for a good relationship",
          "explanation": "After introducing yourself at a first meeting, use よろしくお願いします to express “I hope we can get along well.” A common reply is こちらこそ、よろしくお願いします, returning the same wish."
        },
        "ja": {
          "title": "これから仲よくしたい気持ちを伝える結び",
          "explanation": "初めて会った人に自己紹介をした後、「よろしくお願いします」と言って、これから仲よくしたい気持ちを伝えます。相手はよく「こちらこそ、よろしくお願いします」と返します。"
        }
      },
      "relatedRefs": [
        "draft:ja:first-meeting-opening",
        "draft:ja:polite-noun-predicate",
        "draft:ja:topic-return-question"
      ],
      "exampleRefs": [
        "X01"
      ],
      "presentation": {
        "focusUnitRefs": [
          "X01.s3"
        ]
      }
    },
    "draft:ja:polite-noun-predicate": {
      "localizations": {
        "zh-Hant": {
          "title": "用姓名或身分＋です作禮貌介紹",
          "explanation": "介紹姓名或身分時，可以用「姓名／身分＋です」。例如「学生です」是「我是學生」，是禮貌的說法。介紹自己的姓名時不加さん。"
        },
        "en": {
          "title": "Introducing a name or role with です",
          "explanation": "To introduce your name or role politely, put it before です. For example, 学生です means “I’m a student.” Leave off さん when giving your own name."
        },
        "ja": {
          "title": "名前・立場＋ですで丁寧に紹介する",
          "explanation": "名前や立場を丁寧に伝える時は、その後に「です」を付けます。たとえば「学生です」は、自分が学生だと伝える文です。自分の名前には「さん」を付けません。"
        }
      },
      "relatedRefs": [
        "draft:ja:first-meeting-opening",
        "draft:ja:cooperative-closing",
        "draft:ja:topic-return-question"
      ],
      "exampleRefs": [
        "X02",
        "X03"
      ]
    },
    "draft:ja:topic-return-question": {
      "localizations": {
        "zh-Hant": {
          "title": "沿著剛才的話題問「你呢？」",
          "explanation": "說完自己的身分後，可以用「レンさんは？」問「レン，你呢？」。這裡接著問對方的身分；さん是接在對方姓名後的禮貌稱呼。"
        },
        "en": {
          "title": "Returning the same topic with “And you?”",
          "explanation": "After stating your role, ask レンさんは？: “And you, Ren?” Here you are asking about Ren’s role. さん is a polite form of address after the other person’s name."
        },
        "ja": {
          "title": "同じ話題を相手にも聞く",
          "explanation": "自分の立場を話した後、「レンさんは？」で、レンにも立場を聞けます。「さん」は、相手の名前の後に付ける丁寧な呼び方です。"
        }
      },
      "relatedRefs": [
        "draft:ja:first-meeting-opening",
        "draft:ja:cooperative-closing",
        "draft:ja:polite-noun-predicate"
      ],
      "exampleRefs": [
        "X04"
      ]
    },
    "draft:ja:self-naming": {
      "localizations": {
        "ja": {
          "title": "名前を伝える「〜といいます」",
          "explanation": "「名前＋といいます」で自分の名前を伝えます。「と」は名前を示します。"
        },
        "zh-Hant": {
          "title": "用「〜といいます」介紹姓名",
          "explanation": "「姓名＋といいます」用來介紹自己的姓名；と標示所說的名字。"
        },
        "en": {
          "title": "Giving a name with といいます",
          "explanation": "Use a name followed by といいます to give your name. と marks the name."
        }
      },
      "relatedRefs": [
        "draft:ja:polite-noun-predicate"
      ],
      "exampleRefs": [
        "X05"
      ],
      "presentation": {
        "focusUnitRefs": [
          "I01.s5"
        ]
      }
    },
    "draft:ja:preferred-name-request": {
      "localizations": {
        "ja": {
          "title": "呼び方を伝える「〜と呼んでください」",
          "explanation": "「名前＋と呼んでください」で、その名前で呼んでほしいと頼みます。ここではフルネームの代わりに「レン」を使ってもらいます。"
        },
        "zh-Hant": {
          "title": "用「〜と呼んでください」告訴對方怎麼稱呼你",
          "explanation": "「稱呼＋と呼んでください」用來請對方使用這個稱呼。此處レン希望大家用簡稱，不必叫全名。"
        },
        "en": {
          "title": "Asking to be called a name",
          "explanation": "Use a name followed by と呼んでください to ask people to call you that. Here Ren asks for the shorter name rather than the full name."
        }
      },
      "relatedRefs": [
        "draft:ja:polite-noun-predicate"
      ],
      "exampleRefs": [
        "X06"
      ],
      "presentation": {
        "focusUnitRefs": [
          "I01.s6"
        ]
      }
    },
    "draft:ja:place-of-origin": {
      "localizations": {
        "ja": {
          "title": "来た場所を伝える「〜から来ました」",
          "explanation": "「場所＋から来ました」で、どこから来たかを伝えます。"
        },
        "zh-Hant": {
          "title": "用「〜から来ました」介紹來處",
          "explanation": "「地點＋から来ました」用來說明從哪裡來。"
        },
        "en": {
          "title": "Saying where you are from",
          "explanation": "Use a place followed by から来ました to say where you came from."
        }
      },
      "relatedRefs": [
        "draft:ja:polite-noun-predicate"
      ],
      "exampleRefs": [
        "X07"
      ],
      "presentation": {
        "focusUnitRefs": [
          "I01.s7"
        ]
      }
    },
    "draft:ja:pleasure-at-meeting": {
      "localizations": {
        "ja": {
          "title": "会えた喜びを伝える",
          "explanation": "「お会いできてうれしいです」で、会えたことをうれしく思う気持ちを丁寧に伝えます。初対面のあいさつに添えることができます。"
        },
        "zh-Hant": {
          "title": "表達見面的喜悅",
          "explanation": "「お会いできてうれしいです」禮貌地表達能見到對方的喜悅，也可以用在初見問候中。"
        },
        "en": {
          "title": "Expressing pleasure at meeting",
          "explanation": "お会いできてうれしいです politely expresses pleasure at meeting someone. It can accompany a first-meeting greeting."
        }
      },
      "relatedRefs": [
        "draft:ja:first-meeting-opening",
        "draft:ja:cooperative-closing"
      ],
      "exampleRefs": [
        "X08"
      ],
      "presentation": {
        "focusUnitRefs": [
          "T05.s2"
        ]
      }
    }
  }
