  "localizations": {
    "zh-Hant": {
      "title": "初次見面，也會日常打招呼",
      "intro": "先完成第一次姓名交流，再看不同時段的熟人招呼與道別。不需前課；姓名槽、縮寫與常用詞在本課提供。",
      "goals": {
        "greet": "初次見面時，先開口打招呼。",
        "name": "介紹自己想使用的名字。",
        "respond": "表達見面的喜悅，並回應對方。",
        "ask": "問還不知道的名字，並聽懂回答。",
        "daily": "分辨熟人相遇與道別情境，選擇合適短句。"
      },
      "sources": {
        "meet": {
          "title": "工作坊的新同桌",
          "summary": "Alex和Sam在工作坊開始前坐到同一桌，還不知道彼此的名字。"
        },
        "morning": {
          "title": "隔天上午",
          "summary": "兩人已經認識，早上在活動現場相遇。"
        },
        "afternoon": {
          "title": "下午又碰面",
          "summary": "另一天午後兩人在活動現場碰面。"
        },
        "evening": {
          "title": "晚上到場",
          "summary": "晚上剛抵達活動現場，先打招呼。"
        },
        "leave": {
          "title": "白天活動結束",
          "summary": "兩人白天離開活動現場，之後還會再見。"
        },
        "night": {
          "title": "晚間告別",
          "summary": "晚上的活動結束，兩人正各自回家，互道晚安。"
        }
      },
