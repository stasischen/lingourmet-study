    "theme01-first-meeting-v1:en:words": {
      "id": "theme01-first-meeting-v1:en:words",
      "kind": "expression",
      "status": "draft-candidate",
      "localizations": {
        "zh-Hant": {
          "title": "本課詞語與讀音支援",
          "explanation": "I＝我，you＝你，your＝你的，name＝名字，too＝也，morning＝上午，afternoon＝下午，evening＝晚上，night＝夜晚。good在問候裡與時段一起學。",
          "usage": "Hi讀作/haɪ/，I’m讀作/aɪm/，name讀作/neɪm/；name末尾的e不另成一個音節。可按裝置朗讀先聽整句，再自己讀。",
          "limits": "讀音符號是支援，不是新的考試內容。本課沒有錄音聽寫，也不自動評分發音。"
        }
      },
