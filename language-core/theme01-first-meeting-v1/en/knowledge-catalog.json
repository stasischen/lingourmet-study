    "theme01-first-meeting-v1:en:daily": {
      "id": "theme01-first-meeting-v1:en:daily",
      "kind": "expression",
      "status": "draft-candidate",
      "localizations": {
        "zh-Hant": {
          "title": "日常相遇和告別",
          "explanation": "上午見面可說Good morning，下午Good afternoon，晚上Good evening。Hi、Hello也能作一般招呼。離開時可說Bye；期待再見可說See you。",
          "usage": "Good night用在晚間告別或睡前；晚上剛碰面應選Good evening或一般招呼，不用Good night開場。",
          "limits": "本課問時段題時會指定「明說時段的招呼」；Hi/Hello在不少情境也成立，不會被一律判錯。"
        }
      },
      "exampleRefs": [
        "ex-daily-1",
        "ex-daily-2"
      ],
