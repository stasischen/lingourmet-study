    "theme01-first-meeting-v1:en:name": {
      "id": "theme01-first-meeting-v1:en:name",
      "kind": "grammar",
      "status": "draft-candidate",
      "localizations": {
        "zh-Hant": {
          "title": "說自己：I’m〔名字〕",
          "explanation": "I’m 是 I am 的縮寫，意思是「我是」。把名字放後面：I’m Alex.；I am Alex. 也成立。換成自己的名字時，保留 I’m。",
          "usage": "I 要大寫；縮寫中的撇號標出省略的 a。口說I’m是一個音節；不要把它拆成兩個英文字母來念。",
          "limits": "本課練姓名句；I’m也能接其他描述。沒有要求你用Alex作為自己的名字。"
        }
      },
      "exampleRefs": [
        "ex-name-1",
        "ex-name-2"
      ],
      "relatedRefs": [],
      "provenance": {
        "authoring": "Original project candidate; not source quotation",
        "acceptedBinding": false,
        "curriculumMapping": "external/unmapped"
      }
    },
    "theme01-first-meeting-v1:en:ask": {
      "id": "theme01-first-meeting-v1:en:ask",
      "kind": "grammar",
      "status": "draft-candidate",
      "localizations": {
        "zh-Hant": {
          "title": "問名字：What’s your name?",
          "explanation": "What’s 在這句是 What is 的縮寫；your name 是「你的名字」。What’s your name? 把未知的姓名交給對方回答。",
          "usage": "可先自介再問：I’m Alex. What’s your name? 回答用I’m Sam.，不用把整個問題重複一次。",
          "limits": "I’m Alex.是在報自己的名字，不是在問對方。問句的what不要省掉。"
        }
      },
      "exampleRefs": [
        "ex-ask-1"
      ],
      "relatedRefs": [],
      "provenance": {
        "authoring": "Original project candidate; not source quotation",
        "acceptedBinding": false,
        "curriculumMapping": "external/unmapped"
      }
    },
    "theme01-first-meeting-v1:en:respond": {
      "id": "theme01-first-meeting-v1:en:respond",
      "kind": "expression",
      "status": "draft-candidate",
      "localizations": {
        "zh-Hant": {
          "title": "回應見面致意：You too",
          "explanation": "Nice to meet you 表達很高興認識對方。緊接著回答 You too，意思是「我也很高興認識你」；它承接前一句的意思。",
          "usage": "讀課文時把 Sam 的 Nice to meet you 和 Alex 的 You too 放在一起，辨認回應關係。",
          "limits": "You too不是What’s your name?的姓名答案；在不同前話輪裡，這兩字回應的內容也會改變。"
        }
      },
      "exampleRefs": [
        "ex-respond-1",
        "ex-respond-2"
      ],
      "relatedRefs": [],
