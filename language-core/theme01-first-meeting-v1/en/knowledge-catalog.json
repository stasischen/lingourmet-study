    "theme01-first-meeting-v1:en:greet": {
      "id": "theme01-first-meeting-v1:en:greet",
      "kind": "expression",
      "status": "draft-candidate",
      "localizations": {
        "zh-Hant": {
          "title": "開場：Hi／Hello",
          "explanation": "Hi 和 Hello 都能用來打招呼。Hi 常見於較輕鬆的互動；本課成人同輩的工作坊很適合這樣開口。初見或再遇熟人都可用。",
          "usage": "一口氣練 Hi. I’m Alex.：招呼後接姓名，對方就知道怎麼叫你。",
          "limits": "招呼不是問名字；若還不知道對方名字，下一句再問。"
        }
      },
      "exampleRefs": [
        "ex-greet-1"
      ],
