  "localizations": {
    "zh-Hant": {
      "title": "初次見面，也會日常打招呼",
      "intro": "先練一段成人同輩的禮貌姓名交流，再練「誰走、誰留」的道別。沒有前課要求；名字末音節、空格與固定短句在本課說明。",
      "goals": {
        "greet": "初次見面時，先開口打招呼。",
        "name": "介紹自己想使用的名字。",
        "respond": "表達見面的喜悅，並回應對方。",
        "ask": "問還不知道的名字，並聽懂回答。",
        "daily": "分辨熟人相遇與道別情境，選擇合適短句。"
      },
      "sources": {
        "meet": {
          "title": "活動開始前交換名字",
          "summary": "成人同輩在語言交流活動同桌，初次見面。유나先介紹自己，再問另一位的名字。"
        },
        "daily": {
          "title": "幾天後又碰面",
          "summary": "已經認識的兩位成人在白天活動前再見面，仍用禮貌的語氣。"
        },
        "leave": {
          "title": "一個人先走",
          "summary": "김민준先回家；유나還留在教室收拾。看清楚誰離開、誰留下。"
        },
        "again": {
          "title": "兩個人各自離開",
          "summary": "另一天活動結束，兩人一起離開教室，在路口分開，下次還會再見。"
        }
      },
