  "localizations": {
    "zh-Hant": {
      "title": "初次見面，也會日常打招呼",
      "intro": "Ploy與Nok的自稱、禮貌句尾依各自角色學習。先讀初見對話，再對照誰先離開；原文保留泰語寫法，另有整句讀音提示。",
      "goals": {
        "greet": "初次見面時，先開口打招呼。",
        "name": "介紹自己想使用的名字。",
        "respond": "表達見面的喜悅，並回應對方。",
        "ask": "問還不知道的名字，並聽懂回答。",
        "daily": "分辨熟人相遇與道別情境，選擇合適短句。"
      },
      "sources": {
        "meet": {
          "title": "成人同輩初次交流",
          "summary": "Ploy（พลอย）和Nok（นก）第一次參加交流活動。本課Ploy用เรา與ค่ะ／คะ；Nok用ผม與ครับ。"
        },
        "daily": {
          "title": "下次在門口相遇",
          "summary": "已經認識的Ploy與Nok在活動門口再碰面。"
        },
        "leave": {
          "title": "Nok先離開",
          "summary": "Nok先回家，Ploy還留在活動現場；兩人預期還會見面。"
        },
        "swap": {
          "title": "換Ploy先走",
          "summary": "另一天Ploy先離開，Nok留下來。"
        }
      },
