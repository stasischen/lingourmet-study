  "localizations": {
    "zh-Hant": {
      "title": "初次見面，也會日常打招呼",
      "intro": "先讀「第一次參加讀書會」，再看熟人相遇與道別的短場景。不需前課；名字槽、短句意思與讀音提示都在本課提供。",
      "goals": {
        "greet": "初次見面時，先開口打招呼。",
        "name": "介紹自己想使用的名字。",
        "respond": "表達見面的喜悅，並回應對方。",
        "ask": "問還不知道的名字，並聽懂回答。",
        "daily": "分辨熟人相遇與道別情境，選擇合適短句。"
      },
      "sources": {
        "meet": {
          "title": "第一次參加讀書會",
          "summary": "活動開始前，ミナ與レン坐到同一桌。兩人還不知道彼此的名字。"
        },
        "morning": {
          "title": "隔天早上再見面",
          "summary": "隔天上午，在讀書會門口遇到昨天認識的人。"
        },
        "day": {
          "title": "白天碰面",
          "summary": "過了幾天，兩人在白天的活動現場碰面。"
        },
        "evening": {
          "title": "晚上剛碰面",
          "summary": "兩人晚上剛到活動現場；現在是打招呼，還沒有要回家。"
        },
        "leave": {
          "title": "活動後各自回家",
          "summary": "兩人準備各自回家，下次還會在讀書會見面。"
        },
        "night": {
          "title": "準備休息",
          "summary": "旅行時同住一處的兩位熟人，晚上各自回房睡覺前互道晚安。"
        }
      },
