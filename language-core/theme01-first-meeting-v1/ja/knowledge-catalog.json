  "entries": {
    "theme01-first-meeting-v1:ja:greet": {
      "id": "theme01-first-meeting-v1:ja:greet",
      "kind": "expression",
      "status": "draft-candidate",
      "localizations": {
        "zh-Hant": {
          "title": "初次見面：はじめまして",
          "explanation": "はじめまして 是第一次與這個人見面、開始認識彼此時的開場。說完可以接自己的名字。",
          "usage": "隔天再遇到同一個人，依時段改說 おはようございます、こんにちは 或 こんばんは。",
          "limits": "本課把問候當成完整短句學習；不用先學它們的歷史構詞。"
        }
      },
      "exampleRefs": [
        "ex-greet-1"
      ],
      "relatedRefs": [],
