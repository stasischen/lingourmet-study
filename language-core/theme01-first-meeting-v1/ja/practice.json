      "title": {
        "zh-Hant": "換自己的名字"
      },
      "stage": "application",
      "responseType": "choice",
      "prompt": {
        "zh-Hant": "你想讓同桌叫你ユキ。哪一句是本課的姓名自介？"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "zh-Hant": "お名前は？"
          }
        },
        {
          "id": "B",
          "text": {
            "zh-Hant": "ユキです。"
          }
        },
        {
          "id": "C",
          "text": {
            "zh-Hant": "ユキさんです。"
          }
        }
      ],
      "answer": "B",
      "explanation": {
        "zh-Hant": "用〔自己的名字〕です，不在自稱名字後加さん。"
      },
      "goalRefs": [
        "name"
      ],
      "entryRefs": [
        "theme01-first-meeting-v1:ja:name"
      ],
      "sourceRefs": [
        {
          "unit": "u02"
        }
      ],
      "choiceAssessment": {
        "version": "choice-feedback-v1",
        "responseMode": "selection",
        "feedbackByOption": {
          "A": {
            "zh-Hant": "這是在問對方名字，尚未介紹你自己。"
          },
          "B": {
            "zh-Hant": "對，把名字換成ユキ並保留です。"
          },
          "C": {
            "zh-Hant": "這句可用來介紹別人，但本課自稱不在自己名字後加さん。"
          }
        }
      }
    },
    {
      "id": "Q05",
      "title": {
        "zh-Hant": "問未知的名字"
      },
      "stage": "application",
      "responseType": "choice",
      "prompt": {
        "zh-Hant": "先介紹自己後，還不知道新同桌名字。接哪一句詢問？"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "zh-Hant": "こんにちは。"
          }
        },
        {
          "id": "B",
          "text": {
            "zh-Hant": "レンさんは？"
          }
        },
        {
          "id": "C",
          "text": {
            "zh-Hant": "お名前は？"
          }
        }
      ],
      "answer": "C",
      "explanation": {
        "zh-Hant": "先報自己的名字，再問お名前は，留時間讓對方回答。"
      },
      "goalRefs": [
        "ask"
      ],
      "entryRefs": [
        "theme01-first-meeting-v1:ja:ask"
      ],
      "sourceRefs": [
        {
          "unit": "u03"
        }
      ],
      "choiceAssessment": {
        "version": "choice-feedback-v1",
        "responseMode": "selection",
        "feedbackByOption": {
          "A": {
            "zh-Hant": "這是白天的招呼，沒有問出名字。"
          },
          "B": {
            "zh-Hant": "你還不知道姓名，不能先叫對方レン；名字＋は也要依前話題理解。"
          },
          "C": {
            "zh-Hant": "對，お名前は詢問尚未知的姓名。"
          }
        }
      }
    },
