      "options": [
        {
          "id": "A",
          "text": {
            "zh-Hant": "おはようございます。"
          }
        },
        {
          "id": "B",
          "text": {
            "zh-Hant": "はじめまして。"
          }
        },
        {
          "id": "C",
          "text": {
            "zh-Hant": "おやすみなさい。"
          }
        }
      ],
      "answer": "A",
      "explanation": {
        "zh-Hant": "初見與日常再相遇要分開看。"
      },
      "goalRefs": [
        "daily",
        "greet"
