  "items": [
    {
      "id": "Q01",
      "title": {
        "zh-Hant": "第一次開口"
      },
      "stage": "comprehension",
      "responseType": "choice",
      "prompt": {
        "zh-Hant": "第一次參加讀書會，尚未認識同桌。哪一句明確表示「初次見面」？"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "zh-Hant": "おやすみなさい。"
          }
        },
        {
          "id": "B",
          "text": {
            "zh-Hant": "はじめまして。"
          }
        },
        {
          "id": "C",
          "text": {
            "zh-Hant": "じゃあ、また。"
          }
        }
      ],
      "answer": "B",
      "explanation": {
        "zh-Hant": "先說はじめまして，再接名字，就能開始認識彼此。"
      },
      "goalRefs": [
        "greet"
      ],
      "entryRefs": [
        "theme01-first-meeting-v1:ja:greet"
      ],
      "sourceRefs": [
        {
          "unit": "u01"
        }
      ],
      "choiceAssessment": {
        "version": "choice-feedback-v1",
        "responseMode": "selection",
        "feedbackByOption": {
          "A": {
            "zh-Hant": "這是要休息前的晚安，不是初次認識的開場。"
          },
          "B": {
            "zh-Hant": "對，はじめまして明確用在第一次認識這個人。"
          },
          "C": {
            "zh-Hant": "這是要分開、期待再見時的說法。"
          }
        }
      }
    },
    {
      "id": "Q02",
      "title": {
        "zh-Hant": "讀懂名字"
      },
      "stage": "comprehension",
      "responseType": "choice",
      "prompt": {
        "zh-Hant": "レン回答「レンです」。他使用的名字是哪一個？"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "zh-Hant": "ミナ"
          }
        },
        {
          "id": "B",
          "text": {
            "zh-Hant": "ユキ"
          }
        },
        {
          "id": "C",
          "text": {
            "zh-Hant": "レン"
          }
        }
      ],
      "answer": "C",
      "explanation": {
        "zh-Hant": "姓名自介把名字放在です前面。"
      },
      "goalRefs": [
        "name"
      ],
      "entryRefs": [
        "theme01-first-meeting-v1:ja:name"
      ],
      "sourceRefs": [
        {
          "unit": "u04"
        }
      ],
      "choiceAssessment": {
        "version": "choice-feedback-v1",
        "responseMode": "selection",
        "feedbackByOption": {
          "A": {
            "zh-Hant": "ミナ是先開口的另一位參加者。"
          },
          "B": {
            "zh-Hant": "ユキ出現在教學例句，這段回答的是レン。"
          },
          "C": {
            "zh-Hant": "對，です前面的レン就是他報的名字。"
          }
        }
      }
    },
    {
      "id": "Q03",
      "title": {
        "zh-Hant": "回應心意"
      },
      "stage": "comprehension",
      "responseType": "choice",
      "prompt": {
        "zh-Hant": "對方剛說「よろしくお願いします」。哪一句把同樣的心意回應給對方？"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "zh-Hant": "こちらこそ、よろしくお願いします。"
          }
        },
        {
          "id": "B",
          "text": {
            "zh-Hant": "お名前は？"
          }
        },
        {
          "id": "C",
          "text": {
            "zh-Hant": "こんばんは。"
          }
        }
      ],
      "answer": "A",
      "explanation": {
        "zh-Hant": "對話中由ミナ發起致意，レン用こちらこそ回應。"
      },
      "goalRefs": [
        "respond"
      ],
      "entryRefs": [
        "theme01-first-meeting-v1:ja:respond"
      ],
      "sourceRefs": [
        {
          "unit": "u06"
        }
      ],
      "choiceAssessment": {
        "version": "choice-feedback-v1",
        "responseMode": "selection",
        "feedbackByOption": {
          "A": {
            "zh-Hant": "對，こちらこそ把「我也有同樣心意」接回去。"
          },
          "B": {
            "zh-Hant": "這是在問未知的名字，沒有回應這句致意。"
          },
          "C": {
            "zh-Hant": "這是晚間相遇的招呼，沒有承接請多指教的心意。"
          }
        }
      }
    },
    {
